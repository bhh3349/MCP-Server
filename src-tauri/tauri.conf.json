{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "center": true,
        "decorations": false,
        "focus": true,
        "height": 900,
        "label": "main",
        "maxHeight": 900,
        "maxWidth": 1440,
        "maximizable": false,
        "minHeight": 900,
        "minWidth": 1440,
        "minimizable": true,
        "resizable": false,
        "title": "MCP-Server",
        "transparent": false,
        "url": "http://127.0.0.1:18789",
        "visible": false,
        "width": 1440
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:18789",
    "frontendDist": "../src/dashboard/ui"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "MCP-Server: complete local MCP system — full PC control, tools, plugins, skills, connectors.",
    "resources": [
      "../dist",
      "../node_modules",
      "node-bin"
    ],
    "shortDescription": "MCP-Server 桌面控制中心",
    "targets": "all",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "identifier": "com.mcpserver.app",
  "productName": "MCP-Server",
  "version": "0.1.0"
}